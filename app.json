{
  "expo": {
    "name": "kasir-app",
    "slug": "kasir-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kasirapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.wahyuhidayadd.kasirapp"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "214a30a5-73b3-48ae-bee0-7b559ffaea4f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/214a30a5-73b3-48ae-bee0-7b559ffaea4f"
    }
  }
}
